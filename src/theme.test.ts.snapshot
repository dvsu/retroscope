      }
    },
    {
      "name": "[default] Value: CSS keyframe offset",
      "scope": [
        "entity.other.keyframe-offset"
      ],
      "settings": {
        "foreground": "#D899E0"
      }
    },
    {
      "name": "[default] Regular expression: anchors and wildcards",
      "scope": [
        "support.other.match"
      ],
      "settings": {
        "foreground": "#FA4E26"
      }
    },
    {
      "name": "[default] Regular expression: groups",
      "scope": [
        "support.other.parenthesis"
      ],
      "settings": {
        "foreground": "#A37D70"
      }
    },
    {
      "name": "[default] Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FA4E26"
      }
    },
    {
      "name": "[default] Deprecated code",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#C97B42",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "[default] Markup: heading",
      "scope": [
        "markup.heading"
