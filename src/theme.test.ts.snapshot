  "tokenColors": [
    {
      "name": "[csharp] Keywords, modifiers and operators",
      "scope": [
        "source.cs storage.modifier",
        "source.cs storage.type",
        "source.cs keyword.control",
        "source.cs keyword.other",
        "source.cs keyword.operator",
        "source.cs keyword.preprocessor",
        "source.cs variable.language.this",
        "source.cs punctuation.separator.question-mark"
      ],
      "settings": {
        "foreground": "#CB1F34"
      }
    },
    {
      "name": "[csharp] Function keywords",
      "scope": [
        "source.cs storage.modifier.async"
      ],
      "settings": {
        "foreground": "#82552A"
      }
    },
    {
      "name": "[csharp] Built-in and named types",
      "scope": [
        "source.cs keyword.type",
        "source.cs entity.name.type"
      ],
      "settings": {
        "foreground": "#AA4300"
      }
    },
    {
      "name": "[csharp] Namespaces",
      "scope": [
        "source.cs entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#2E3428"
      }
    },
    {
      "name": "[csharp] Null",
      "scope": [
        "source.cs constant.language.null"
      ],
      "settings": {
        "foreground": "#DA5F8C"
      }
    },
    {
      "name": "[csharp] Punctuation: member access and null-conditional access",
      "scope": [
        "source.cs keyword.operator.null-conditional",
        "source.cs punctuation.accessor"
      ],
      "settings": {
        "foreground": "#A68765"
      }
    },
    {
      "name": "[dart] Comment",
      "scope": [
        "comment.line.double-slash.dart"
      ],
      "settings": {
        "foreground": "#9E9A9A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[dart] Function, method, decorator",
      "scope": [
        "entity.name.function.dart",
        "storage.type.annotation.dart"
      ],
      "settings": {
        "foreground": "#007388"
      }
    },
    {
      "name": "[dart] Keywords",
      "scope": [
        "keyword.operator.bitwise.dart",
        "keyword.control.catch-exception.dart",
        "keyword.control.return.dart",
        "keyword.declaration.dart",
        "keyword.operator.arithmetic.dart",
        "keyword.operator.assignment.dart",
        "keyword.operator.closure.dart",
        "keyword.operator.comparison.dart",
        "keyword.operator.ternary.dart",
        "keyword.other.import.dart",
        "other.source.dart",
        "storage.modifier.dart",
        "variable.language.dart"
      ],
      "settings": {
        "foreground": "#CB1F34"
      }
    },
    {
      "name": "[dart] Keywords: function, async, if-else, switch-case, yield",
      "scope": [
        "keyword.control.dart"
      ],
      "settings": {
        "foreground": "#82552A"
      }
    },
    {
      "name": "[dart] Misc",
      "scope": [
        "source.dart"
      ],
      "settings": {
        "foreground": "#2E3428"
      }
    },
    {
      "name": "[dart] Punctuations",
      "scope": [
        "meta.embedded.expression.dart",
        "punctuation.comma.dart",
        "punctuation.dot.dart",
        "punctuation.terminator.dart"
      ],
      "settings": {
        "foreground": "#A68765"
      }
    },
    {
      "name": "[dart] Type definition",
      "scope": [
        "storage.type.primitive.dart",
        "support.class.dart"
      ],
      "settings": {
        "foreground": "#AA4300"
      }
    },
    {
      "name": "[dart] Value: boolean",
      "scope": [
        "\\tconstant.language.dart"
      ],
      "settings": {
        "foreground": "#4E2686"
      }
    },
    {
      "name": "[dart] Value: boolean, number",
      "scope": [
        "constant.numeric.dart"
      ],
      "settings": {
        "foreground": "#4E2686"
      }
    },
    {
      "name": "[dart] Value: string",
      "scope": [
        "string.interpolated.single.dart"
      ],
      "settings": {
        "foreground": "#4D8343"
      }
    },
    {
      "name": "[dart] Variable names",
      "scope": [
        "meta.declaration.dart",
        "variable.parameter.dart"
      ],
      "settings": {
        "foreground": "#2E3428"
      }
    },
    {
      "name": "[dockerfile] Comment",
      "scope": [
        "comment.line.number-sign.dockerfile"
      ],
      "settings": {
        "foreground": "#9E9A9A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[dockerfile] Comment punctuations",
      "scope": [
        "punctuation.definition.comment.dockerfile"
      ],
      "settings": {
        "foreground": "#A68765"
      }
    },
    {
      "name": "[dockerfile] Keywords",
      "scope": [
        "keyword.control.dockerfile",
        "keyword.other.special-method.dockerfile"
      ],
      "settings": {
        "foreground": "#CB1F34"
      }
    },
    {
      "name": "[dockerfile] Value: string",
      "scope": [
        "string.quoted.double.dockerfile"
      ],
      "settings": {
        "foreground": "#4D8343"
      }
    },
    {
      "name": "[default] Comment",
      "scope": [
        "source comment",
        "text comment"
      ],
      "settings": {
        "foreground": "#9E9A9A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[default] Comment punctuations",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A68765"
      }
    },
    {
      "name": "[default] Function, method, decorator",
      "scope": [
        "source entity.name.function",
        "text entity.name.function",
        "entity.name.operator"
      ],
      "settings": {
        "foreground": "#007388"
      }
    },
    {
      "name": "[default] Keywords",
      "scope": [
        "source keyword",
        "text keyword",
        "support.other.directive"
      ],
      "settings": {
        "foreground": "#CB1F34"
      }
    },
    {
      "name": "[default] Keywords: function, async, storage modifier",
      "scope": [
        "storage.type.function",
        "keyword.other.fn",
        "storage.modifier.async",
        "storage.type.function.arrow",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#82552A"
      }
    },
    {
      "name": "[default] Import paths and package names",
      "scope": [
        "storage.modifier.import",
        "entity.name.package",
        "meta.import entity.name.package",
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.namespace-prefix",
        "entity.other.namespace-prefix",
        "entity.other.alias",
        "entity.name.scope-resolution",
        "support.other.namespace",
        "meta.import",
        "meta.package"
      ],
      "settings": {
        "foreground": "#2E3428"
      }
    },
    {
      "name": "[default] Template expression interpolation",
      "scope": [
        "meta.template.expression",
        "entity.string.template.element",
        "variable.other.interpolated.expression"
      ],
      "settings": {
        "foreground": "#2E3428"
      }
    },
    {
      "name": "[default] Misc",
      "scope": [
        "source"
      ],
      "settings": {
        "foreground": "#2E3428"
      }
    },
    {
      "name": "[default] Punctuations",
      "scope": [
        "source punctuation",
        "text punctuation"
      ],
      "settings": {
        "foreground": "#A68765"
      }
    },
    {
      "name": "[default] Type definition",
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#AA4300"
      }
    },
    {
      "name": "[default] Value: boolean",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#4E2686"
      }
    },
    {
      "name": "[default] Value: number",
      "scope": [
        "constant.numeric",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#4E2686"
      }
    },
    {
      "name": "[default] Value: string",
      "scope": [
        "source string",
        "text string"
      ],
      "settings": {
        "foreground": "#4D8343"
      }
    },
    {
      "name": "[default] Variable names",
      "scope": [
        "constant.other",
        "source variable",
        "text variable"
      ],
      "settings": {
        "foreground": "#2E3428"
      }
    },
    {
      "name": "[default] Keywords: storage type",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#CB1F34"
      }
    },
    {
      "name": "[default] Type definition: built-in and named types",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.generic",
        "storage.type.java",
        "storage.type.sql",
        "support.class",
        "entity.name.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#AA4300"
      }
    },
    {
      "name": "[default] Built-in functions",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#007388"
      }
