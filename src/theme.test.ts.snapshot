  "tokenColors": [
    {
      "name": "[csharp] Keywords, modifiers and operators",
      "scope": [
        "source.cs storage.modifier",
        "source.cs storage.type",
        "source.cs keyword.control",
        "source.cs keyword.other",
        "source.cs keyword.operator",
        "source.cs keyword.preprocessor",
        "source.cs variable.language.this",
        "source.cs punctuation.separator.question-mark"
      ],
      "settings": {
        "foreground": "#FF7445"
      }
    },
    {
      "name": "[csharp] Function keywords",
      "scope": [
        "source.cs storage.modifier.async"
      ],
      "settings": {
        "foreground": "#F1C13C"
      }
    },
    {
      "name": "[csharp] Built-in and named types",
      "scope": [
        "source.cs keyword.type",
        "source.cs entity.name.type"
      ],
      "settings": {
        "foreground": "#F19F25"
      }
    },
    {
      "name": "[csharp] Namespaces",
      "scope": [
        "source.cs entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#FFCC9E"
      }
    },
    {
      "name": "[csharp] Null",
      "scope": [
        "source.cs constant.language.null"
      ],
      "settings": {
        "foreground": "#F58288"
      }
    },
    {
      "name": "[csharp] Punctuation: member access and null-conditional access",
      "scope": [
        "source.cs keyword.operator.null-conditional",
        "source.cs punctuation.accessor"
