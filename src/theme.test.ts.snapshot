  "tokenColors": [
    {
      "name": "[csharp] Keywords, modifiers and operators",
      "scope": [
        "source.cs storage.modifier",
        "source.cs storage.type",
        "source.cs keyword.control",
        "source.cs keyword.other",
        "source.cs keyword.operator",
        "source.cs keyword.preprocessor",
        "source.cs variable.language.this",
        "source.cs punctuation.separator.question-mark"
      ],
      "settings": {
        "foreground": "#FA4E26"
      }
    },
    {
      "name": "[csharp] Function keywords",
      "scope": [
        "source.cs storage.modifier.async"
      ],
      "settings": {
        "foreground": "#F3C03A"
      }
    },
    {
      "name": "[csharp] Built-in and named types",
      "scope": [
        "source.cs keyword.type",
        "source.cs entity.name.type"
      ],
      "settings": {
        "foreground": "#F3A149"
      }
    },
    {
      "name": "[csharp] Namespaces",
      "scope": [
        "source.cs entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#FFD3BD"
      }
    },
    {
      "name": "[csharp] Null",
      "scope": [
        "source.cs constant.language.null"
      ],
      "settings": {
        "foreground": "#EF7A85"
      }
    },
    {
      "name": "[csharp] Punctuation: member access and null-conditional access",
      "scope": [
        "source.cs keyword.operator.null-conditional",
        "source.cs punctuation.accessor"
      ],
      "settings": {
        "foreground": "#A37D70"
      }
    },
    {
      "name": "[dart] Comment",
      "scope": [
        "comment.line.double-slash.dart"
      ],
      "settings": {
        "foreground": "#7D6070",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[dart] Function, method, decorator",
      "scope": [
        "entity.name.function.dart",
        "storage.type.annotation.dart"
      ],
      "settings": {
        "foreground": "#6DB8B5"
      }
    },
    {
      "name": "[dart] Keywords",
      "scope": [
        "keyword.operator.bitwise.dart",
        "keyword.control.catch-exception.dart",
        "keyword.control.return.dart",
        "keyword.declaration.dart",
        "keyword.operator.arithmetic.dart",
        "keyword.operator.assignment.dart",
        "keyword.operator.closure.dart",
        "keyword.operator.comparison.dart",
        "keyword.operator.ternary.dart",
        "keyword.other.import.dart",
        "other.source.dart",
        "storage.modifier.dart",
        "variable.language.dart"
      ],
      "settings": {
        "foreground": "#FA4E26"
      }
    },
    {
      "name": "[dart] Keywords: function, async, if-else, switch-case, yield",
      "scope": [
        "keyword.control.dart"
      ],
      "settings": {
        "foreground": "#F3C03A"
      }
    },
    {
      "name": "[dart] Misc",
      "scope": [
        "source.dart"
      ],
      "settings": {
        "foreground": "#FFD3BD"
      }
    },
    {
      "name": "[dart] Punctuations",
      "scope": [
        "meta.embedded.expression.dart",
        "punctuation.comma.dart",
        "punctuation.dot.dart",
        "punctuation.terminator.dart"
      ],
      "settings": {
        "foreground": "#A37D70"
      }
    },
    {
      "name": "[dart] Type definition",
      "scope": [
        "storage.type.primitive.dart",
        "support.class.dart"
      ],
      "settings": {
        "foreground": "#F3A149"
      }
    },
    {
      "name": "[dart] Value: boolean",
      "scope": [
        "\\tconstant.language.dart"
      ],
      "settings": {
        "foreground": "#D899E0"
      }
    },
    {
      "name": "[dart] Value: boolean, number",
      "scope": [
        "constant.numeric.dart"
      ],
      "settings": {
        "foreground": "#D899E0"
      }
    },
    {
      "name": "[dart] Value: string",
      "scope": [
        "string.interpolated.single.dart"
      ],
      "settings": {
        "foreground": "#9EC17D"
      }
    },
    {
      "name": "[dart] Variable names",
      "scope": [
        "meta.declaration.dart",
        "variable.parameter.dart"
      ],
      "settings": {
        "foreground": "#FFD3BD"
      }
    },
    {
      "name": "[dockerfile] Comment",
      "scope": [
        "comment.line.number-sign.dockerfile"
      ],
      "settings": {
        "foreground": "#7D6070",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[dockerfile] Comment punctuations",
      "scope": [
        "punctuation.definition.comment.dockerfile"
      ],
      "settings": {
        "foreground": "#A37D70"
      }
    },
    {
      "name": "[dockerfile] Keywords",
      "scope": [
        "keyword.control.dockerfile",
        "keyword.other.special-method.dockerfile"
      ],
      "settings": {
        "foreground": "#FA4E26"
      }
    },
    {
      "name": "[dockerfile] Value: string",
      "scope": [
        "string.quoted.double.dockerfile"
      ],
      "settings": {
        "foreground": "#9EC17D"
      }
    },
    {
      "name": "[default] Comment",
      "scope": [
        "source comment",
        "text comment"
      ],
      "settings": {
        "foreground": "#7D6070",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[default] Comment punctuations",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A37D70"
      }
    },
    {
      "name": "[default] Function, method, decorator",
