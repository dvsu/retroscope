{
  "name": "Retroscope Soft",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#8AAEA1",
    "method": "#8AAEA1",
    "delegate": "#E79D34",
    "*.constructor": "#8AAEA1",
    "*.importDeclaration": "#FFCB97"
  },
  "colors": {
