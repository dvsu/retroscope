        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#FFCB93"
      }
    },
    {
      "name": "[yaml] Version and tags",
      "scope": [
        "constant.numeric.yaml-version.yaml",
        "support.type.tag-prefix.yaml",
        "storage.type.tag-handle.yaml"
      ],
      "settings": {
        "foreground": "#EF9B47"
      }
    }
  ]
}
`;

