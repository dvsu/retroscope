      ],
      "settings": {
        "foreground": "#F75123"
      }
    },
    {
      "name": "[default] Type definition: built-in and named types",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.generic",
        "storage.type.java",
        "storage.type.sql",
        "support.class",
