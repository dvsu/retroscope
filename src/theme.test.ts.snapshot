      }
    },
    {
      "name": "[default] Object key",
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#C9AAA5"
      }
    },
    {
      "name": "[default] Braces",
      "scope": [
        "meta.brace"
      ],
      "settings": {
        "foreground": "#A37D70"
      }
    },
    {
      "name": "[default] Value: escape and entity characters",
      "scope": [
        "constant.character",
        "support.other.escape"
      ],
      "settings": {
        "foreground": "#799FC5"
      }
    },
    {
      "name": "[default] Constants: enum cases, labels, macros",
      "scope": [
        "constant.enum",
        "entity.name.label",
        "entity.name.goto-label",
