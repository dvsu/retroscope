{
  "name": "retroscope",
  "displayName": "Retroscope",
  "description": "Warm, retro dark themes for VS Code, Cursor and Antigravity. Easy on the eyes for long sessions.",
  "type": "module",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "icon": "assets/retroscope_255x255.png",
  "galleryBanner": {
    "color": "#1D1B19",
    "theme": "dark"
  },
  "version": "0.4.1",
  "author": "David Su",
  "publisher": "dvsu",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvsu/retroscope"
  },
  "homepage": "https://github.com/dvsu/retroscope#readme",
  "bugs": {
    "url": "https://github.com/dvsu/retroscope/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "color-theme",
    "dark",
    "dark theme",
    "retro",
    "warm",
    "high contrast",
    "accessibility",
    "color blind",
    "cursor",
    "antigravity",
    "retroscope",
    "themes"
  ],
  "contributes": {
    "themes": [
      {
        "id": "Retroscope",
        "label": "Retroscope",
        "uiTheme": "vs-dark",
        "path": "./themes/retroscope-color-theme.json"
      },
      {
        "id": "Retroscope HC",
        "label": "Retroscope High Contrast",
        "uiTheme": "vs-dark",
        "path": "./themes/retroscope-high-contrast-color-theme.json"
      },
      {
        "id": "Retroscope Soft",
        "label": "Retroscope Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/retroscope-soft-color-theme.json"
      },
      {
        "id": "Retroscope Amber",
        "label": "Retroscope Amber",
        "uiTheme": "vs-dark",
        "path": "./themes/retroscope-amber-color-theme.json"
      },
      {
        "id": "Retroscope Cassette",
        "label": "Retroscope Cassette",
        "uiTheme": "vs-dark",
        "path": "./themes/retroscope-cassette-color-theme.json"
      },
      {
        "id": "Retroscope Phosphor",
        "label": "Retroscope Phosphor",
        "uiTheme": "vs-dark",
        "path": "./themes/retroscope-phosphor-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "dev": "tsx watch src/build.ts --exclude ./node_modules/**/*",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "yarn lint && yarn typecheck && yarn build && yarn test && yarn check:package",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:update": "node --import tsx --test --test-update-snapshots \"src/**/*.test.ts\"",
    "check:package": "tsx src/check-package.ts",
    "package:vsix": "vsce package --no-dependencies --githubBranch main --baseImagesUrl https://raw.githubusercontent.com/dvsu/retroscope/main",
    "coverage": "tsx src/coverage-report.ts",
    "screenshots": "tsx src/screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.3.0",
    "shiki": "4.5.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "@vscode/vsce": "4.0.0"
  },
  "files": [
    "themes/retroscope-amber-color-theme.json",
    "themes/retroscope-cassette-color-theme.json",
    "themes/retroscope-color-theme.json",
    "themes/retroscope-high-contrast-color-theme.json",
    "themes/retroscope-phosphor-color-theme.json",
    "themes/retroscope-soft-color-theme.json",
    "assets/retroscope_255x255.png",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
