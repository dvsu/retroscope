{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": ["src/**", "*.json", ".vscode/*.json"]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "includes": ["**", "!package.json"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
