{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": ["demo/**", "themes/**", "build.cjs"]
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "ignore": ["package.json"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
